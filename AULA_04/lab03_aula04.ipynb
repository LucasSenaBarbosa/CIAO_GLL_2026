import numpy as np


# ============================================================
# CONFIGURAÇÕES
# ============================================================

np.random.seed(2026)

T = [12, 35, 40, 8, 15, 22, 19, 45, 60, 31,
     14, 28, 50, 18, 25, 33, 42, 10, 5, 29]

NUM_TAREFAS = len(T)
NUM_SERVIDORES = 4

TAM_POPULACAO = 100
GERACOES = 200
TAXA_MUTACAO = 0.10


# ============================================================
# FUNÇÃO DE CÁLCULO DO MAKESPAN
# ============================================================

def calcular_makespan(individuo):
    cargas = [0] * NUM_SERVIDORES

    for tarefa in range(NUM_TAREFAS):
        servidor = individuo[tarefa]
        cargas[servidor] += T[tarefa]

    return max(cargas)


# ============================================================
# CRIAÇÃO DE UM INDIVÍDUO
# ============================================================

def criar_individuo():
    return np.random.randint(
        0,
        NUM_SERVIDORES,
        size=NUM_TAREFAS
    )


# ============================================================
# CRIAÇÃO DA POPULAÇÃO
# ============================================================

def criar_populacao():
    return [
        criar_individuo()
        for _ in range(TAM_POPULACAO)
    ]


# ============================================================
# SELEÇÃO
# ============================================================

def selecionar_pai(populacao):
    i, j = np.random.choice(
        len(populacao),
        2,
        replace=False
    )

    custo_i = calcular_makespan(populacao[i])
    custo_j = calcular_makespan(populacao[j])

    if custo_i < custo_j:
        return populacao[i].copy()

    return populacao[j].copy()


# ============================================================
# CRUZAMENTO
# ============================================================

def cruzamento(pai1, pai2):

    ponto = np.random.randint(1, NUM_TAREFAS)

    filho = np.concatenate(
        (
            pai1[:ponto],
            pai2[ponto:]
        )
    )

    return filho


# ============================================================
# MUTAÇÃO
# ============================================================

def mutacao(individuo):

    for i in range(NUM_TAREFAS):

        if np.random.rand() < TAXA_MUTACAO:

            individuo[i] = np.random.randint(
                0,
                NUM_SERVIDORES
            )

    return individuo


# ============================================================
# ALGORITMO GENÉTICO
# ============================================================

populacao = criar_populacao()

melhor_individuo = None
melhor_makespan = float("inf")

for geracao in range(GERACOES):

    # Avalia todos os indivíduos
    custos = [
        calcular_makespan(individuo)
        for individuo in populacao
    ]

    # Descobre o melhor indivíduo da geração
    indice_melhor = np.argmin(custos)

    if custos[indice_melhor] < melhor_makespan:

        melhor_makespan = custos[indice_melhor]

        melhor_individuo = populacao[
            indice_melhor
        ].copy()

    # Nova população
    nova_populacao = []

    # Elitismo: mantém o melhor indivíduo
    nova_populacao.append(
        melhor_individuo.copy()
    )

    while len(nova_populacao) < TAM_POPULACAO:

        pai1 = selecionar_pai(populacao)
        pai2 = selecionar_pai(populacao)

        filho = cruzamento(pai1, pai2)

        filho = mutacao(filho)

        nova_populacao.append(filho)

    populacao = nova_populacao


# ============================================================
# RESULTADO FINAL
# ============================================================

cargas_finais = [0] * NUM_SERVIDORES

for tarefa in range(NUM_TAREFAS):

    servidor = melhor_individuo[tarefa]

    cargas_finais[servidor] += T[tarefa]


print("=" * 50)
print("RESULTADO DO DESAFIO 03")
print("=" * 50)

print("\nMelhor indivíduo:")
print(melhor_individuo)

print("\nDistribuição das tarefas:")

for servidor in range(NUM_SERVIDORES):

    tarefas_servidor = []

    for tarefa in range(NUM_TAREFAS):

        if melhor_individuo[tarefa] == servidor:
            tarefas_servidor.append(tarefa)

    print(
        f"Servidor {servidor}: "
        f"tarefas {tarefas_servidor} "
        f"-> carga = {cargas_finais[servidor]} segundos"
    )

print("\nCargas dos servidores:")
print(cargas_finais)

print(f"\nMakespan final: {melhor_makespan} segundos")


"""Uma observação importante
A soma de todas as tarefas é:

12 + 35 + 40 + 8 + 15 + 22 + 19 + 45 + 60 + 31
+ 14 + 28 + 50 + 18 + 25 + 33 + 42 + 10 + 5 + 29
= 541 segundos

Como temos 4 servidores, o limite teórico seria:

541 / 4 = 135,25 segundos

Ou seja, não é possível ter Makespan menor que 135,25 s, porque os servidores precisam processar todas as 541 segundos de trabalho.

Na prática, como as tarefas não podem ser divididas, provavelmente teremos um Makespan um pouco acima disso.
"""
